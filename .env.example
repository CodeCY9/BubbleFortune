# ==============================================================================
# BubbleFortune - 本地开发环境配置示例 (.env.example)
# 复制为 .env.local 进行本地开发与调试，禁止将包含真实密钥的文件提交至 Git 仓库
# ==============================================================================

# ------------------------------------------------------------------------------
# 基础服务与监听配置
# ------------------------------------------------------------------------------
# 游戏服务端内部监听端口（默认 2567）
PORT=2567

# 游戏服务端监听主机地址（开发环境默认 0.0.0.0）
HOST=0.0.0.0

# 运行环境模式（开发模式: development，生产模式: production）
NODE_ENV=development

# ------------------------------------------------------------------------------
# 域名与跨域来源配置 (CORS & WebSocket Origin)
# ------------------------------------------------------------------------------
# 公开访问基准域名（本地开发默认前端端口 3000）
PUBLIC_ORIGIN=http://localhost:3000

# 允许跨域访问与 WebSocket 握手连接的源
# 用于 verifyClientUpgrade 与 HTTP API 的跨域安全校验
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 数据库连接 (PostgreSQL)
# ------------------------------------------------------------------------------
# 本地开发默认 PostgreSQL 容器连接串（通过 npm run db:setup / npm run db:up 启动）
# 格式: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
DATABASE_URL=postgresql://bubble_fortune:CHANGEME_DEV_PASSWORD@127.0.0.1:15434/bubble_fortune

# ------------------------------------------------------------------------------
# 安全凭证与风控密钥 (本地开发占位说明)
# ------------------------------------------------------------------------------
# 管理后台安全令牌（必须是高熵字符串，开发环境可使用长随机占位串）
# 用于 X-Admin-Token 请求头认证及签名 bf_admin 会话 Cookie
BF_ADMIN_TOKEN=dev_admin_token_replace_with_min_32_chars_random_secret

# IP 指纹与风控脱敏盐值（必须保密，不可硬编码在代码或提交至版本库）
# 计算公式为 SHA-256(BF_RISK_SECRET + IP)，服务端绝不保存或回显原始 IP
BF_RISK_SECRET=dev_risk_secret_replace_with_min_32_chars_random_secret
