# ==============================================================================
# BubbleFortune - 生产环境配置模板 (.env.production.example)
#
# 【安全核心准则】
# 1. 在生产部署宿主机上复制为 .env.production 并设定严格权限: chmod 600 .env.production
# 2. 绝对严禁将真实凭据、私钥提交到 Git 仓库或写入 Dockerfile / 镜像构建层
# 3. 所有 SECRET 占位符必须替换为高熵密码学安全随机字符串 (推荐: openssl rand -hex 32)
# ==============================================================================

# ------------------------------------------------------------------------------
# 运行环境模式与反向代理端口
# ------------------------------------------------------------------------------
# 强制设为 production: 自动启用 bf_guest 和 bf_admin Cookie 的 Secure 属性 (需 HTTPS)
NODE_ENV=production

# 反向代理外部公开暴露端口 (通常为 80，若由宿主机前置 Nginx/云负载均衡器终结 SSL，则暴露对应端口)
PORT=80
# 使用 docker-compose.production.yml 时的 TLS 端口与证书目录
HTTP_PORT=80
HTTPS_PORT=443
TLS_CERT_DIR=./docker/certs

# ------------------------------------------------------------------------------
# 域名与跨域/WebSocket 来源 (必须使用真实线上 HTTPS/WSS 域名)
# ------------------------------------------------------------------------------
# 生产公开访问基准域名 (用于公开分享链接、规范 URL 与权威校验)
# 示例: https://game.example.com
PUBLIC_ORIGIN=https://bubblefortune.example.com

# 允许跨域 API 请求与 WebSocket 连接升级的源 (verifyClientUpgrade 校验)
# 生产环境中只允许受信任的正式前端域名
ALLOWED_ORIGINS=https://bubblefortune.example.com

# ------------------------------------------------------------------------------
# PostgreSQL 数据库凭据 (内部容器网络)
# ------------------------------------------------------------------------------
# 数据库名称与应用专有账号
POSTGRES_DB=bubble_fortune
POSTGRES_USER=bubble_fortune

# 数据库超级用户/应用用户密码 (必须使用高熵密码，替换下方占位符)
# 生成命令: openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD_MIN_32_CHARS

# 内部 Docker Compose 服务间连接串 (指向 postgres 服务及内部 5432 端口)
# 注意: 替换其中的密码部分与上方 POSTGRES_PASSWORD 一致
DATABASE_URL=postgresql://bubble_fortune:REPLACE_WITH_STRONG_RANDOM_PASSWORD_MIN_32_CHARS@postgres:5432/bubble_fortune

# ------------------------------------------------------------------------------
# 安全凭证与风控密钥 (必须保密)
# ------------------------------------------------------------------------------
# 管理员特权安全令牌 (用于 X-Admin-Token 请求头认证及签名 bf_admin 会话 Cookie)
# 泄露将导致攻击者可调用全量后台、封禁、配置重载与审计接口
# 必须使用高熵密钥 (至少 32 字符/字节): openssl rand -hex 32
BF_ADMIN_TOKEN=REPLACE_WITH_HIGH_ENTROPY_ADMIN_TOKEN_MIN_32_CHARS

# 风控与 IP 脱敏盐值 (用于 SHA-256 离散化客户端 IP 指纹)
# 计算规则: SHA-256(BF_RISK_SECRET + 客户端IP)
# 服务端绝不存储或输出原始 IP，必须保持此密钥长期稳定以保障防作弊指纹一致性
# 生成命令: openssl rand -hex 32
BF_RISK_SECRET=REPLACE_WITH_HIGH_ENTROPY_RISK_SECRET_MIN_32_CHARS
